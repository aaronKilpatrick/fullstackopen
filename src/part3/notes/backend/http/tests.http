@baseUrl = http://localhost:3001

### Get all notes
# @name getNotes
GET {{ baseUrl }}/api/notes HTTP/1.1

### Add a note
# @name addNote
POST {{ baseUrl }}/api/notes HTTP/1.1
Content-Type: application/json

{
    "content": "Kulala is good in testing the backend",
    "important": true
}

### Get a note
# @name getNote
GET {{ baseUrl }}/api/notes/2 HTTP/1.1

### Delete Note
# @name deleteNote
DELETE {{ baseUrl }}/api/notes/2 HTTP/1.1
